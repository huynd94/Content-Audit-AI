# Production environment template for direct Node.js/systemd or Docker deployment.

# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
CORS_ORIGIN=https://audit.example.com

# Database
DATABASE_URL=postgresql://content_audit_ai:change-me@127.0.0.1:5432/content_audit_ai

# OpenAI
OPENAI_API_KEY=sk-change-me
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=8192

# Review fetch guardrails
FETCH_CONTENT_TIMEOUT_MS=15000
FETCH_CONTENT_MAX_ATTEMPTS=2
FETCH_CONTENT_MAX_CHARS=8000

# Abuse controls
RATE_LIMIT_WINDOW_MS=60000
CREATE_REVIEW_RATE_LIMIT_MAX=20
ANALYZE_RATE_LIMIT_MAX=10
