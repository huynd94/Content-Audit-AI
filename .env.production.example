# Mẫu biến môi trường production cho triển khai trực tiếp bằng Node.js/systemd hoặc Docker.

# Môi trường chạy
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
CORS_ORIGIN=https://kiem-duyet.example.com

# Cơ sở dữ liệu
DATABASE_URL=postgresql://content_audit_ai:doi-mat-khau-o-day@127.0.0.1:5432/content_audit_ai

# OpenAI
OPENAI_API_KEY=sk-thay-bang-khoa-that
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=8192

# Giới hạn khi tải nội dung để phân tích
FETCH_CONTENT_TIMEOUT_MS=15000
FETCH_CONTENT_MAX_ATTEMPTS=2
FETCH_CONTENT_MAX_CHARS=8000

# Kiểm soát chống lạm dụng
RATE_LIMIT_WINDOW_MS=60000
CREATE_REVIEW_RATE_LIMIT_MAX=20
ANALYZE_RATE_LIMIT_MAX=10
